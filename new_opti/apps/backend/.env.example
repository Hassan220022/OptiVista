# ===========================================
# OptiVista Backend Environment Configuration
# ===========================================

# Supabase (Self-Hosted)
SUPABASE_URL=https://your-supabase-instance.example.com
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Paymob Payment Gateway (Required)
PAYMOB_API_KEY=your-paymob-api-key-here
PAYMOB_INTEGRATION_ID=your-integration-id
PAYMOB_IFRAME_ID=your-iframe-id
PAYMOB_SECRET_KEY=your-paymob-secret-key-here
PAYMOB_PUBLIC_KEY=your-paymob-public-key-here

# CORS Origins (no wildcard — add production domains when deploying)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
